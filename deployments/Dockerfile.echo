# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

# Copy the echo server source
COPY tests/stress/echo_server.go .

# Build the echo server fully statically
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o echo_server echo_server.go

# Minimal run stage
FROM scratch
WORKDIR /
COPY --from=builder /app/echo_server /echo_server
ENTRYPOINT ["/echo_server"]
